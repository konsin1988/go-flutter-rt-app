scalar Date
scalar UUID

type Department {
  id: Int!
  name: String!
  parent: Int!
  head: Int!
}

type Head {
  id: Int!
  fio: String!
}

type User {
  id: Int! 
  firstName: String!
  lastName: String!
  secondName: String!
  email: String!
  birthday: String 
  photoURL: String
  mobile: String
  inner: String
  position: String
  deptList: [Department!]!
  headList: [Head!]!
}

type UserContact {
  label: String
  type: String!
  value: String!
}

type Query {
  mainUser: User
}

# texx
type TexxPost {
  DocumentId:	ID!	  
  Title:	String!
  Link:		String!
  PublishedAt:	String!
  PreviewImage: String!
  PostText:	String!
}

extend type Query {
  texxPosts: [TexxPost!]!
}

# ai
type Conversation {
  id: Int!
  title: String
  messages(limit: Int, offset: Int): [Message!]!
  createdAt: Date!
  updatedAt: Date!
} 

type ConversationListItem {
  id: Int!
  title: String!
  createdAt: Date!
  updatedAt: Date!

}

type Message {
  id: Int!
  role: MessageRole!
  content: String!
  createdAt: Date!
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

extend type Query {
  ConversationList: [ConversationListItem!]!
}

extend type Query {
  ConversationById(id: Int!): Conversation!
}




































