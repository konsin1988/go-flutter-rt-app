scalar Date
scalar UUID

type Department {
  id: Int!
  name: String!
  parent: Int!
  head: Int!
}

type Head {
  id: Int!
  fio: String!
}

type User {
  id: Int! 
  firstName: String!
  lastName: String!
  secondName: String
  email: String!
  birthday: String 
  photoURL: String
  mobile: String
  inner: String
  position: String
  deptList: [Department!]!
  headList: [Head!]!
}

type Query {
  mainUser: User
}

extend type Query {
  userById(user_id: Int!): User!
}

# texx
type TexxPost {
  DocumentId:	ID!	  
  Title:	String!
  Link:		String!
  PublishedAt:	String!
  PreviewImage: String!
  PostText:	String!
}

extend type Query {
  texxPosts: [TexxPost!]!
}

# ai
type Conversation {
  id: Int!
  title: String!
  messages(limit: Int!, before: Date): [Message!]!
  createdAt: Date!
  updatedAt: Date!
} 

type ConversationListItem {
  id: Int!
  title: String!
  createdAt: String!
  updatedAt: String!
  isPinned: Int!
}

type Message {
  id: Int!
  conversationId: Int!
  role: MessageRole!
  content: String!
  createdAt: Date!
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

extend type Query {
  ConversationList: [ConversationListItem!]!
}

extend type Query {
  ConversationById(id: Int!): Conversation!
}

extend type Mutation {
  createMessage(conversationId: Int, content: String!): Message! 
}

extend type Mutation {
  deleteConversation(conversationId: Int!): Boolean! 
}

extend type Mutation {
  togglePinnedConversation(conversationId: Int!, isPinned: Int!): Boolean!
}

extend type Mutation {
  renameConversation(conversationId: Int!, newTitle: String!): ConversationListItem 
}

# Absence
type AbsenceUI {
  id: Int
  time_from: String!
  time_to: String!
  type_of_absence: Int!
}

extend type Mutation {
  createAbsenceData(prompt: String!): AbsenceUI!
}

input AbsenceInput {
  id: Int
  time_from: String!
  time_to: String!
  type_of_absence: Int!
}
extend type Mutation {
  createAbsenceBitrix(absence: AbsenceInput!): AbsenceUI
}

# Depts
type DeptUser {
  id: Int!
  fio: String!
  position: String
  photoURL: String
}

type DeptById {
  id: Int!
  name: String!
  parent: Int
  parentName: String
  head: Int
  headFIO: String
  deptUserList: [DeptUser!]!
}

extend type Query {
  GetDeptById(dept_id: Int!): DeptById!
}

type ChatStreamChunk {
  chunk: String!
  done: Boolean!
}

type Subscription {
  messageStream(messageId: Int!, conversationId: Int!): ChatStreamChunk!
}

