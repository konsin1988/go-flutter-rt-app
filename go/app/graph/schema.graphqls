type User {
  login: String!
  about: String
  avatarImageUrl: String
  displayName: String
  email: String!
}
type UserContact {
  label: String
  type: String!
  value: String!
}
type Query {
  me: User
}

# ghost 
type Post {
  id: ID!
  title: String!
  html: String!
  slug: String!
  feature_image: String!
}

extend type Query {
  posts: [Post!]!
}

# texx
type TexxPost {
  DocumentId:	ID!	  
  Title:	String!
  Link:		String!
  PublishedAt:	String!
  PreviewImage: String!
  PostText:	String!
}

extend type Query {
  texxPosts: [TexxPost!]!
}















